pragma solidity ^0.8.19;

import {IPreLiquidation, PreLiquidationParams} from "lib/pre-liquidation/src/interfaces/IPreLiquidation.sol";
import {IPreLiquidationFactory} from "lib/pre-liquidation/src/interfaces/IPreLiquidationFactory.sol";
import {Id as PreLiquidationId} from "lib/pre-liquidation/lib/morpho-blue/src/interfaces/IMorpho.sol";

/// @title PreLiquidationBytecode
/// @notice Contains pre-compiled creation bytecode for PreLiquidation contracts
/// @dev These contracts were compiled with Solidity 0.8.27 and via-ir enabled.
///      This allows us to deploy them in tests without requiring via-ir during test compilation.
///      Using creation bytecode allows proper constructor execution with parameters.
library PreLiquidationBytecode {
  /// @notice Creation bytecode for PreLiquidationFactoryWrapper (compiled with via-ir)
  function getFactoryCreationCode() internal pure returns (bytes memory) {
    return hex"";
  }

  /// @notice Creation bytecode for PreLiquidationWrapper (compiled with via-ir)
  function getPreLiquidationCreationCode() internal pure returns (bytes memory) {
    return hex"";
  }

  /// @notice Deploy PreLiquidationFactory using CREATE with constructor arguments
  /// @param morpho The Morpho contract address
  /// @return factory The deployed factory address
  function deployFactory(address morpho) internal returns (IPreLiquidationFactory factory) {
    bytes memory creationCode = getFactoryCreationCode();
    bytes memory constructorArgs = abi.encode(morpho);
    bytes memory initCode = bytes.concat(creationCode, constructorArgs);

    address factoryAddr;
    assembly {
      factoryAddr := create(0, add(initCode, 0x20), mload(initCode))
    }

    require(factoryAddr != address(0), "Factory deployment failed");
    return IPreLiquidationFactory(factoryAddr);
  }

  /// @notice Deploy PreLiquidation using CREATE with constructor arguments
  /// @param morpho The Morpho contract address
  /// @param marketId The market ID
  /// @param params The PreLiquidation parameters
  /// @return preLiquidation The deployed PreLiquidation address
  function deployPreLiquidation(address morpho, PreLiquidationId marketId, PreLiquidationParams memory params)
    internal
    returns (IPreLiquidation preLiquidation)
  {
    bytes memory creationCode = getPreLiquidationCreationCode();
    bytes memory constructorArgs = abi.encode(morpho, marketId, params);
    bytes memory initCode = bytes.concat(creationCode, constructorArgs);

    address preLiqAddr;
    assembly {
      preLiqAddr := create(0, add(initCode, 0x20), mload(initCode))
    }

    require(preLiqAddr != address(0), "PreLiquidation deployment failed");
    return IPreLiquidation(preLiqAddr);
  }
}
